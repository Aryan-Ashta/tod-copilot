# Variable names only. The real values live in Doppler (project tod-copilot, config prd; see doppler.yaml and
# AGENTS.md rule 8): run backend commands as `doppler run -- <command>`. Copying this to .env is a local fallback.
ANTHROPIC_API_KEY=
TOD_MODEL=anthropic:claude-haiku-5-5
TOD_LLM=1
DEMO_OFFLINE=0
NREL_API_KEY=DEMO_KEY
REPLAY_DELAY_S=0.25
# Agent research (docs/12), recording time only. RESEARCH_MODEL defaults to TOD_MODEL. Search uses Anthropic's
# server-side web search with ANTHROPIC_API_KEY (no extra key) or a fixture file: fixture:<path.yaml>.
RESEARCH_MODEL=
RESEARCH_SEARCH=anthropic
RESEARCH_SEARCH_MODEL=anthropic:claude-haiku-5-5
# 1: research drawn Harris/LA areas in the background after their plan is shown (needs the key and network)
AREA_RESEARCH=0
# HackPrinceton CoStar track: run /costar-keys in the track Discord (#costar-group) to get these.
# Matterport Model API (GraphQL, HTTP basic auth: key:token) at https://api.matterport.com/api/models/graph
MP_API_KEY=
MP_API_TOKEN=
# Vexcel API 2.0 at https://api.vexcelgroup.com/v2, sent as the X-API-KEY header
VEXCEL_API_KEY=
# CoStar is a password-protected data extract (download link + password from /costar-keys), not an API:
# unzip it under cache/costar/ (git-ignored).
# LangSmith tracing: on when the key is set and DEMO_OFFLINE is not 1. Inputs/outputs are always hidden
# (licensed data must not leave this machine); traces keep agent/tool structure, timing and tokens.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tod-copilot
