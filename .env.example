ANTHROPIC_API_KEY=
TOD_MODEL=anthropic:claude-haiku-5-5
TOD_LLM=1
DEMO_OFFLINE=0
NREL_API_KEY=DEMO_KEY
REPLAY_DELAY_S=0.25
# HackPrinceton CoStar track: run /costar-keys in the track Discord (#costar-group) to get these.
# Matterport Model API (GraphQL, HTTP basic auth: key:token) at https://api.matterport.com/api/models/graph
MP_API_KEY=
MP_API_TOKEN=
# Vexcel API 2.0 at https://api.vexcelgroup.com/v2, sent as the X-API-KEY header
VEXCEL_API_KEY=
# CoStar is a password-protected data extract (download link + password from /costar-keys), not an API:
# unzip it under cache/costar/ (git-ignored).
# LangSmith tracing: on when the key is set and DEMO_OFFLINE is not 1. Inputs/outputs are always hidden
# (licensed data must not leave this machine); traces keep agent/tool structure, timing and tokens.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tod-copilot
